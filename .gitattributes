# Auto-detect text files and normalize to LF
* text=auto

# TypeScript/JavaScript source files
*.ts text diff=typescript
*.tsx text diff=typescript
*.js text
*.jsx text
*.json text
*.mjs text

# SQL
*.sql text

# Markdown
*.md text

# YAML
*.yml text
*.yaml text

# Shell scripts
*.sh text eol=lf

# Environment files
.env* text

# Binary files
*.png binary
*.jpg binary
*.ico binary
